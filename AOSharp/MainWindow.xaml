<Controls:MetroWindow x:Class="AOSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AOSharp"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        AllowDrop="True"
        PreviewDragOver="PluginFiles_DragOver"
        PreviewDrop="PluginFiles_Drop"
        Title="KAO# 2.7.18"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        TitleForeground="{DynamicResource TextBrush}"
        OverrideDefaultWindowCommandsBrush="{DynamicResource TextBrush}"
        Width="1000" Height="500" MinWidth="1000" MinHeight="450">
    <Controls:MetroWindow.RightWindowCommands>
        <Controls:WindowCommands>
            <Button ToolTip="Tweaks" Click="TweaksButton_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE713;"/>
            </Button>
        </Controls:WindowCommands>
    </Controls:MetroWindow.RightWindowCommands>
    <Window.Resources>
        <ResourceDictionary>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibleConverter"
                                             TrueValue="Visible" FalseValue="Collapsed"/>
            <local:PathIsInvalidConverter x:Key="PathIsInvalidConverter"/>
            <Style x:Key="NewActivityButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource WindowsSelectionTextBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- Text follows the row's Windows foreground, including selected rows. -->
            <Style x:Key="PluginStatusTextStyle" TargetType="{x:Type TextBlock}"
                   BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                <Setter Property="Foreground"
                        Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"/>
            </Style>
            <!-- Inherit the installed MahApps 1.6.x templates; native fallbacks are light. -->
            <Style x:Key="LauncherGridCellStyle" TargetType="{x:Type DataGridCell}"
                   BasedOn="{StaticResource MetroDataGridCell}">
                <Setter Property="BorderBrush" Value="{DynamicResource WindowsBorderBrush}"/>
                <Setter Property="BorderThickness" Value="0.5"/>
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="Foreground"
                        Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}"/>
                        <Setter Property="Foreground"
                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="LauncherGridHeaderStyle" TargetType="{x:Type DataGridColumnHeader}"
                   BasedOn="{StaticResource MetroDataGridColumnHeader}">
                <Setter Property="Background" Value="{DynamicResource WindowsControlBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource WindowsControlTextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource WindowsBorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Controls:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
            </Style>
            <Style x:Key="LauncherGridRowStyle" TargetType="{x:Type DataGridRow}"
                   BasedOn="{StaticResource MetroDataGridRow}">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource WindowsSelectionBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource WindowsSelectionTextBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MetroDataGrid}">
                <!-- Background colors the unused viewport too, including an entirely empty list. -->
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource WindowsBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CellStyle" Value="{StaticResource LauncherGridCellStyle}"/>
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource LauncherGridHeaderStyle}"/>
                <Setter Property="RowStyle" Value="{StaticResource LauncherGridRowStyle}"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserReorderColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="GridLinesVisibility" Value="All"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource WindowsBorderBrush}"/>
                <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource WindowsBorderBrush}"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="RowBackground" Value="{DynamicResource ControlBackgroundBrush}"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource ControlBackgroundBrush}"/>
            </Style>
            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MetroTextBox}">
                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource GrayBrush2}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <TabControl x:Name="WorkspaceTabs" Margin="0,0,0,5" Padding="0" BorderThickness="0"
                        Controls:TabControlHelper.Underlined="SelectedTabItem"
                        Controls:TabControlHelper.UnderlineBrush="Transparent"
                        Controls:TabControlHelper.UnderlineMouseOverBrush="Transparent"
                        Controls:TabControlHelper.UnderlineSelectedBrush="{DynamicResource WindowsSelectionTextBrush}"
                        Controls:TabControlHelper.UnderlineMouseOverSelectedBrush="{DynamicResource WindowsSelectionTextBrush}"
                        SelectionChanged="WorkspaceTabs_SelectionChanged">
                <TabItem x:Name="LibraryTab" Header="Plugin list" Padding="14,5"/>
                <TabItem x:Name="NewActivityTab" Padding="0" IsTabStop="False" HeaderTemplate="{x:Null}">
                    <TabItem.Header>
                        <Button Content="+" Width="32" Height="28" MinWidth="32" MinHeight="28"
                                Padding="0" FontSize="18" Style="{StaticResource NewActivityButtonStyle}"
                                BorderThickness="0" Background="Transparent" Focusable="False"
                                ToolTip="Create an activity: name its new column on Plugin list"
                                Click="NewActivity_Click"/>
                    </TabItem.Header>
                </TabItem>
            </TabControl>
        </ScrollViewer>

        <DockPanel x:Name="LibraryPanel" Grid.Row="1">
            <DockPanel DockPanel.Dock="Top" Margin="3,3,3,6">
                <Button DockPanel.Dock="Right" Margin="3" Padding="12,4" Click="ShowAddPluginDialog"
                        ToolTip="Select DLLs, or drag and drop them anywhere on this window">Add Plugin</Button>
                <TextBlock Text="{Binding SetupMessage}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="3"/>
            </DockPanel>
            <DataGrid x:Name="LibraryGrid" Margin="3" ItemsSource="{Binding LibraryPlugins}"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      PreviewMouseRightButtonDown="LibraryGrid_PreviewMouseRightButtonDown">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Value.Name}" SortMemberPath="Value.Name" Width="220"/>
                    <!-- Activity membership columns are inserted here, before version/source. -->
                    <DataGridTextColumn Header="Version" Binding="{Binding Value.Version}" SortMemberPath="Value.Version" Width="100"/>
                    <DataGridTextColumn Header="Source" Binding="{Binding Value.Path}" SortMemberPath="Value.Path" Width="*" MinWidth="200"/>
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Remove selected plugins" Click="RemoveSelectedPlugins_Click"/>
                        <MenuItem Header="Remove All" Click="RemoveAllPlugins_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.RowStyle>
                    <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource LauncherGridRowStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Value.Path, Converter={StaticResource PathIsInvalidConverter}}" Value="True">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="ToolTip" Value="This plugin DLL cannot be found at its registered path."/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </DockPanel>

        <Grid x:Name="ActivityPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="ProfileListBox" Grid.Column="0" Margin="3" BorderThickness="2"
                     Background="{DynamicResource ControlBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
                     BorderBrush="{DynamicResource WindowsBorderBrush}"
                     ItemsSource="{Binding Profiles}" SelectionChanged="ProfileListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2">
                            <TextBlock Text="{Binding Name}"/>
                            <TextBlock Text="{Binding LiveActivityName}" FontSize="11"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource MetroListBoxItem}">
                        <Setter Property="Controls:ItemHelper.HoverBackgroundBrush" Value="{DynamicResource ControlBackgroundBrush}"/>
                        <Setter Property="Controls:ItemHelper.DisabledBackgroundBrush" Value="{DynamicResource ControlBackgroundBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsInjected}" Value="True">
                                <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <DockPanel Grid.Column="1">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Margin="3" Orientation="Horizontal">
                        <Button Margin="3" Padding="12,4" Click="InjectButton_Clicked" IsEnabled="{Binding CanInject}">Inject</Button>
                        <Button Margin="3" Padding="12,4" Click="EjectButton_Clicked" IsEnabled="{Binding CanEject}">Eject</Button>
                        <Button Margin="3" Padding="12,4" Click="InjectAllButton_Clicked">Inject All</Button>
                        <Button Margin="3" Padding="12,4" Click="EjectAllButton_Clicked"
                                ToolTip="Eject characters running this activity only">Eject All</Button>
                    </StackPanel>
                    <TextBlock Text="{Binding InjectionHint}" TextWrapping="Wrap" Margin="8,0,8,7"/>
                    <TextBlock Margin="8,0,8,7" TextWrapping="Wrap"
                               Visibility="{Binding ActivityHasNoPlugins, Converter={StaticResource BoolToVisibleConverter}}"
                               Text="Choose plugins for this activity on Plugin list."/>
                </StackPanel>
                <DataGrid x:Name="ActivityGrid" Margin="3" ItemsSource="{Binding ActivityPlugins}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Enabled (next injection)" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding HasProfileSelected, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Click="PluginEnabledCheckBox_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Name" Binding="{Binding Plugin.Name}" SortMemberPath="Plugin.Name" Width="*"
                                            ElementStyle="{StaticResource PluginStatusTextStyle}"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding LoadStatus}" SortMemberPath="LoadStatus" Width="120"
                                            ElementStyle="{StaticResource PluginStatusTextStyle}"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource LauncherGridRowStyle}">
                            <Setter Property="ToolTip" Value="{Binding LoadDetail}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LoadStatus}" Value="Initialized">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LoadStatus}" Value="Failed">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LoadStatus}" Value="Loading">
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Plugin.Path, Converter={StaticResource PathIsInvalidConverter}}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="ToolTip" Value="This plugin DLL cannot be found at its registered path."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </DockPanel>
        </Grid>
        <DockPanel Grid.Row="2" Margin="6,3">
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,2"
                    Visibility="{Binding SaveFailed, Converter={StaticResource BoolToVisibleConverter}}"
                    Click="RetrySave_Click">Retry</Button>
            <TextBlock Text="{Binding SaveStatus}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Controls:MetroWindow>
