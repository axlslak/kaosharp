<Controls:MetroWindow x:Class="AOSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AOSharp"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
        AllowDrop="True"
        PreviewDragOver="PluginFiles_DragOver"
        PreviewDrop="PluginFiles_Drop"
        mc:Ignorable="d"
        Title="KAO# 2.7.12"
        Width="1000"
        Height="450"
        MinWidth="1000"
        MinHeight="450">
    <Controls:MetroWindow.RightWindowCommands>
        <Controls:WindowCommands>
            <Button ToolTip="Tweaks"
                    Click="TweaksButton_Click">
                <TextBlock FontFamily="Segoe MDL2 Assets" 
                           FontSize="14" 
                           Text="&#xE713;"/>
            </Button>
        </Controls:WindowCommands>
    </Controls:MetroWindow.RightWindowCommands>
    <Window.Resources>
        <ResourceDictionary>
            <local:BoolToVisibilityConverter x:Key="BoolToHiddenConverter"
                                             TrueValue="Collapsed" 
                                             FalseValue="Visible" />
            <local:BoolToVisibilityConverter x:Key="BoolToVisibleConverter"
                                             TrueValue="Visible" 
                                             FalseValue="Collapsed" />
            <!-- Bind text directly: selected-cell theme brushes must not hide row status colors. -->
            <Style x:Key="PluginStatusTextStyle" TargetType="{x:Type TextBlock}"
                   BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                <Setter Property="Foreground"
                        Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}"/>
            </Style>
            <local:RemovePluginConverter x:Key="RemovePluginConverter"/>
            <local:PathIsInvalidConverter x:Key="PathIsInvalidConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ListBox Name="ProfileListBox"
         Grid.Column="0"
         BorderThickness="2"
         ItemsSource="{Binding Profiles}"
         DisplayMemberPath="Name"
         SelectionChanged="ProfileListBox_SelectionChanged">

            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsInjected}" Value="True">
                            <Setter Property="Foreground" Value="LightGreen"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>

        </ListBox>

        <DockPanel Grid.Column="1">
            <DockPanel DockPanel.Dock="Top" Margin="3">
                <Grid Name="InjectButtonContainer" Width="76" DockPanel.Dock="Left"
                      Visibility="{Binding HasProfileSelected, Converter={StaticResource BoolToVisibleConverter}}">
                    <Button Margin="3" Click="InjectButton_Clicked"
                            Visibility="{Binding ActiveProfile.IsInjected, Converter={StaticResource BoolToHiddenConverter}}">Inject</Button>
                    <Button Margin="3" Click="EjectButton_Clicked"
                            Visibility="{Binding ActiveProfile.IsInjected, Converter={StaticResource BoolToVisibleConverter}}">Eject</Button>
                </Grid>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Margin="3" Padding="10,3" Click="InjectAllButton_Clicked">Inject All</Button>
                    <Button Margin="3" Padding="10,3" Click="EjectAllButton_Clicked">Eject All</Button>
                </StackPanel>
                <Button HorizontalAlignment="Right" Margin="3" Padding="10,3" Click="ShowAddPluginDialog" ToolTip="Select DLLs, or drag and drop them anywhere on this window">Add Plugin</Button>
            </DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,6,3">
                <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="Plugin profile"/>
                <ComboBox x:Name="UserProfileComboBox" Width="180" Margin="0,0,6,0" IsEditable="True"
                          ItemsSource="{Binding UserProfileNames}"
                          Text="{Binding SelectedUserPluginProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Width="55" Margin="0,0,4,0" Click="SaveUserPluginProfileButton_Click">Save</Button>
                <Button Width="55" Margin="0,0,4,0" Click="LoadUserPluginProfileButton_Click">Load</Button>
                <Button Width="55" Click="DeleteUserPluginProfileButton_Click">Del</Button>
            </StackPanel>
            <DataGrid Name="PluginsDataGrid"
          Margin="5"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ItemsSource="{Binding Path=Plugins}"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          IsEnabled="true"
          IsReadOnly="true"
          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
          GridLinesVisibility="All"
          HorizontalGridLinesBrush="#555555"
          VerticalGridLinesBrush="#555555"
          AlternationCount="2"
          RowBackground="#2A2A2A"
          AlternatingRowBackground="#242424">

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Enabled (next injection)">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Click="PluginEnabledCheckBox_Click" IsChecked="{Binding Value.IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding DataContext.HasProfileSelected, RelativeSource={RelativeSource AncestorType=Window}}">
                                </CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn ElementStyle="{StaticResource PluginStatusTextStyle}" Header="Name"
                                        Binding="{Binding Value.Name}"
                                        Width="200"/>
                    <DataGridTextColumn ElementStyle="{StaticResource PluginStatusTextStyle}" Header="Status" Binding="{Binding Value.LoadStatus}" Width="110"/>
                    <DataGridTextColumn ElementStyle="{StaticResource PluginStatusTextStyle}" Header="Version"
                                        Binding="{Binding Value.Version}" 
                                        Width="100"/>
                    <DataGridTextColumn ElementStyle="{StaticResource PluginStatusTextStyle}" Header="Source"
                                        Binding="{Binding Value.Path}" 
                                        Width="*"/>
                </DataGrid.Columns>
                <DataGrid.Resources>
                    <ContextMenu x:Key="RowMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Remove" Command="{Binding Value.RemoveCommand}">
                            <MenuItem.CommandParameter>
                                <MultiBinding Converter="{StaticResource RemovePluginConverter}">
                                    <Binding Path="DataContext.Plugins"
                                 RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type DataGrid}}"/>
                                    <Binding Path="Key"/>
                                </MultiBinding>
                            </MenuItem.CommandParameter>
                        </MenuItem>
                        <MenuItem Header="Remove All" Click="RemoveAllPlugins_Click"/>
                    </ContextMenu>

                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderBrush" Value="#555555"/>
                        <Setter Property="BorderThickness" Value="0.5"/>
                        <Setter Property="Padding" Value="4,2"/>
                    </Style>

                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.GrayBrush}" />
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderBrush" Value="#555555"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Padding" Value="4,2,4,2"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
                        <Setter Property="ToolTip" Value="{Binding Value.LoadDetail}"/>
                        <Setter Property="BorderBrush" Value="#555555"/>
                        <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Value.LoadStatus}" Value="Initialized">
                                <Setter Property="Foreground" Value="LimeGreen"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Value.LoadStatus}" Value="Failed">
                                <Setter Property="Foreground" Value="Red"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Value.LoadStatus}" Value="Loading">
                                <Setter Property="Foreground" Value="DarkOrange"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Value.Path, Converter={StaticResource PathIsInvalidConverter}}" Value="True">
                                <Setter Property="Foreground" Value="Red"/>
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

        </DockPanel>
    </Grid>
</Controls:MetroWindow>
