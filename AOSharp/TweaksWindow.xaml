<Controls:MetroWindow x:Class="AOSharp.TweaksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
        mc:Ignorable="d"
        Title="Tweaks"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        TitleForeground="{DynamicResource TextBrush}"
        OverrideDefaultWindowCommandsBrush="{DynamicResource TextBrush}"
        Height="440"
        MinHeight="440" 
        Width="560"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowMinButton="False"
        ShowMaxRestoreButton="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,20,20,10">
            <Grid Margin="0,0,0,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Content="AO Install Directory:" Margin="0,0,0,5"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Name="InstallDirectoryTextBox"
                             Grid.Column="0"
                             IsReadOnly="True"
                             Text="{Binding InstallDirectory, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,5,0"/>
                    <Button Name="BrowseDirectoryButton"
                            Grid.Column="1"
                            Width="75"
                            Click="BrowseDirectoryButton_Click"
                            IsEnabled="{Binding IsIdle}">
                        Browse...
                    </Button>
                </Grid>
            </Grid>

            <Button Name="EnableLargeAddressAwareButton"
                    Height="40"
                    Margin="0,15,0,0"
                    Click="EnableLargeAddressAwareButton_Click"
                    IsEnabled="{Binding CanEnableLargeAddressAware}">
                Enable large address aware
            </Button>

            <TextBlock Margin="0,18,0,4" FontWeight="SemiBold"
                       Text="New client: full-speed background" />
            <TextBlock TextWrapping="Wrap"
                       Text="Keeps the new client running at full speed in the background, using more CPU/GPU. Close AO and its game launcher before changing this option." />
            <TextBlock Margin="0,8,0,8" TextWrapping="Wrap"
                       Text="{Binding BackgroundModeStatus}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Height="36" Margin="0,0,5,0"
                        Click="EnableFullSpeedBackgroundButton_Click"
                        IsEnabled="{Binding CanEnableFullSpeedBackground}">
                    Enable full-speed background
                </Button>
                <Button Grid.Column="1" Height="36" Margin="5,0,0,0"
                        Click="RestoreBackgroundThrottleButton_Click"
                        IsEnabled="{Binding CanRestoreBackgroundThrottle}">
                    Restore background throttle
                </Button>
            </Grid>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="20,0,20,20">
            <Button Name="CloseButton"
                    Width="75"
                    Click="CloseButton_Click"
                    IsCancel="True"
                    IsEnabled="{Binding IsIdle}">
                Close
            </Button>
        </StackPanel>
    </Grid>
</Controls:MetroWindow>
